+        end = list(m_sel(resi = 2), m_sel(resi = 3))
+      ), 2
+    )
+  })
+
+  it("error if mismatch in input lengths", {
+    model <- r3dmol() %>%
+      m_add_model(data = pdb_6zsl)
+
+    expect_error(
