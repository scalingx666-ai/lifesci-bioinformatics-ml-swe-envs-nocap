+      /**
+        * Sets the location of the element relative to the parseInt
+        * as per position types
+        * @function setLocation
+        * 
+        * @param  {Object} parent jquery object
+        * @param  {Object} child  jquery object
+        * @param  {String} x_type 'left|right'
