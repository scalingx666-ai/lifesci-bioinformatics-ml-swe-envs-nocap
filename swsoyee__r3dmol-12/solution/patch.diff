+        return value;
+      // uint 16
+      case 0xcd:
+        value = dataView.getUint16(offset + 1);
+        offset += 3;
+        return value;
+      // uint 32
+      case 0xce:
+        value = dataView.getUint32(offset + 1);
+        offset += 5;
+        return value;
