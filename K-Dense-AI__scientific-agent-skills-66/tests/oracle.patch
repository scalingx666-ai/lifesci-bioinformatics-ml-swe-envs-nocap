+
+        return {
+            "success": True,
+            "query": query,
+            "response": result["content"],
+            "output": result["content"],
+            "citations": result["sources"],
+            "sources": result["sources"],
+            "citation_count": result["citation_count"],
+            "model": model,
+            "backend": "parallel-chat",
+            "timestamp": result["timestamp"],
