+                if 'km_value_numeric' in parsed:
+                    kms.append(parsed['km_value_numeric'])
+
+            if phs:
+                ph_range = (min(phs), max(phs))
+                is_alkaline_stable = min_ph and ph_range[0] >= min_ph
